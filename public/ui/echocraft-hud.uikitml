<style>
  .hud-root {
    flex-direction: column;
    width: 280px;
    background-color: rgba(10, 15, 29, 0.82);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.2);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
  }

  .hud-header {
    flex-direction: column;
    gap: 3px;
    margin-bottom: 8px;
  }

  .eyebrow {
    color: #38bdf8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
  }

  .subtitle {
    color: #94a3b8;
    font-size: 11px;
    line-height: 14px;
  }

  .status-container {
    flex-direction: column;
    gap: 5px;
    margin-bottom: 8px;
  }

  .fragment-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(15, 23, 42, 0.7);
    border-radius: 6px;
  }

  .fragment-name {
    font-size: 11px;
    font-weight: 600;
    color: #cbd5e1;
  }

  .fragment-badge {
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
  }

  .action-buttons {
    flex-direction: row;
    gap: 5px;
    margin-bottom: 8px;
  }

  .mini-btn {
    flex-grow: 1;
    height: 26px;
  }

  .epilogue-box {
    display: none;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(30, 27, 75, 0.85);
    border-radius: 8px;
    border-width: 1px;
    border-color: #818cf8;
  }

  .epilogue-quote {
    font-size: 11px;
    font-weight: 700;
    color: #fde68a;
    line-height: 14px;
    text-align: center;
  }

  .epilogue-sub {
    font-size: 10px;
    color: #c7d2fe;
    text-align: center;
  }

  .footer-row {
    flex-direction: row;
    gap: 6px;
  }

  .bottom-btn {
    flex-grow: 1;
    height: 28px;
  }
</style>

<Panel class="hud-root">
  <div class="hud-header">
    <div class="eyebrow">ECHOCRAFT VR</div>
    <div class="title">The Last Light</div>
    <div id="narrative-prompt" class="subtitle">
      Place the three memory fragments to restore the island.
    </div>
  </div>

  <div class="status-container">
    <div class="fragment-row">
      <div class="fragment-name">1. Warmth</div>
      <div id="badge-warmth" class="fragment-badge">WAITING</div>
    </div>
    <div class="fragment-row">
      <div class="fragment-name">2. Life</div>
      <div id="badge-life" class="fragment-badge">WAITING</div>
    </div>
    <div class="fragment-row">
      <div class="fragment-name">3. Hope</div>
      <div id="badge-hope" class="fragment-badge">WAITING</div>
    </div>
  </div>

  <div class="action-buttons">
    <Button id="btn-snap-warmth" class="mini-btn">
      <ButtonLabel>Warmth</ButtonLabel>
    </Button>
    <Button id="btn-snap-life" class="mini-btn">
      <ButtonLabel>Life</ButtonLabel>
    </Button>
    <Button id="btn-snap-hope" class="mini-btn">
      <ButtonLabel>Hope</ButtonLabel>
    </Button>
  </div>

  <div id="epilogue-panel" class="epilogue-box">
    <div class="epilogue-quote">
      "Memories are the anchors that bring us home."
    </div>
    <div class="epilogue-sub">
      The Island Lives Again
    </div>
  </div>

  <div class="footer-row">
    <Button id="xr-button" class="bottom-btn">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel>Enter XR</ButtonLabel>
    </Button>
    <Button id="exit-button" class="bottom-btn" style="display: none">
      <ButtonIcon>
        <LogIn></LogIn>
      </ButtonIcon>
      <ButtonLabel>Exit XR</ButtonLabel>
    </Button>
    <Button id="btn-restart" class="bottom-btn">
      <ButtonIcon>
        <RotateCcw></RotateCcw>
      </ButtonIcon>
      <ButtonLabel>Reset</ButtonLabel>
    </Button>
  </div>
</Panel>
