{
  "version": 2,
  "cleanUrls": true,
  "framework": "vite",
  "build": {
    "env": {
      "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
